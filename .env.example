# Copy to .env.local. Empty values are intentional; never commit a real AK.
PORT=4173
NODE_ENV=development
VITE_BAIDU_MAP_AK=
BAIDU_SERVER_AK=
PRODUCTION_ISOCHRONE_ALGORITHM=walking36
# Enable the existing real Walking sampler only after configuring server AK.
# BAIDU_WALKING_SAMPLING_FALLBACK_ENABLED follows whether server AK is set.
BAIDU_API_TIMEOUT_MS=8000
BAIDU_WALKING_CONCURRENCY=10
BAIDU_WALKING_MIN_INTERVAL_MS=110
BAIDU_PLACE_CONCURRENCY=6
BAIDU_PLACE_MIN_INTERVAL_MS=105
BAIDU_PLACE_TASK_LIMIT=60
BAIDU_WALKING_TASK_LIMIT=220
BAIDU_CIRCLE_ROUTE_LIMIT=1000
BAIDU_COMPLETE_FACILITY_PATHS_ENABLED=true
ANALYSIS_TIMEOUT_MS=600000
# Matrix costs are optional and require your own verified grant.
BAIDU_BATCH_WALKING_ENABLED=false
BAIDU_BATCH_WALKING_DAILY_LIMIT=10000
BAIDU_BATCH_WALKING_OUTPUT_QPS=10
BAIDU_BATCH_WALKING_VALID_UNTIL=
WALKING_ACCELERATION_ENABLED=true
ADAPTIVE_DIRECTIONS_ENABLED=true
ADAPTIVE_DIRECTION_OD_BUDGET=18
WALKING_CACHE_TTL_SECONDS=86400
